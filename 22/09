
CREATE TABLE Editora (
    ID_Editora INT PRIMARY KEY,
    NomeFantasia_Editora VARCHAR(100),
    RazaoSocial_Editora VARCHAR(100),
    PAIS VARCHAR(50)
);

CREATE TABLE Autor (
    ID_Autor INT PRIMARY KEY,
    Nome_Autor VARCHAR(100),
    RG_Autor VARCHAR(20)
);

CREATE TABLE Financiador (
    ID_Financiador INT PRIMARY KEY,
    Nome_Financiador VARCHAR(100)
);

CREATE TABLE Cliente (
    ID_Cliente INT PRIMARY KEY,
    Nome_Cliente VARCHAR(100),
    RG_Cliente VARCHAR(20),
    CPF_Cliente VARCHAR(20),
    PAIS VARCHAR(50)
);

CREATE TABLE Livro (
    ID_Livro INT PRIMARY KEY,
    ISBN_Livro VARCHAR(30),
    Titulo_Livro VARCHAR(100),
    Preco_Livro DECIMAL(10,2),
    Categoria_Livro VARCHAR(50),
    ID_Editora INT,
    ID_Autor INT,
    ID_Financiador INT,

    FOREIGN KEY (ID_Editora)
        REFERENCES Editora(ID_Editora),

    FOREIGN KEY (ID_Autor)
        REFERENCES Autor(ID_Autor),

    FOREIGN KEY (ID_Financiador)
        REFERENCES Financiador(ID_Financiador)
);




